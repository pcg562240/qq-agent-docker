# npm run docker:init generates a random console password. Never commit .env.
QQ_AGENT_CONSOLE_TOKEN=
QQ_AGENT_PORT=3210
# LAN opt-in: set BIND_ADDRESS=0.0.0.0 and allow your Mac LAN IP:port below.
QQ_AGENT_BIND_ADDRESS=127.0.0.1
# Comma-separated exact host:port values (no http://, paths or wildcards).
QQ_AGENT_ALLOWED_HOSTS=
# qqbot = official QQ bot; onebot = separately deployed OneBot server.
QQ_AGENT_CHANNEL=qqbot
# Optional: leave blank and enter these in the connection settings page.
QQBOT_APP_ID=
QQBOT_APP_SECRET=
ONEBOT_WS_URL=ws://host.docker.internal:3001
ONEBOT_HTTP_URL=http://host.docker.internal:3000
ONEBOT_ACCESS_TOKEN=
ONEBOT_HTTP_TOKEN=
NODE_IMAGE=node:22-bookworm-slim

# Used only by compose.release.yaml (prebuilt image).
QQ_AGENT_IMAGE=ghcr.io/pcg562240/qq-agent-docker:0.4.7-docker.1
