{
  "name": "qq-agent",
  "version": "0.4.0",
  "private": false,
  "description": "QQ Agent Docker / 官方 QQ 适配版，主上游 K0nd1us/QQ-agent Git 源码",
  "type": "module",
  "main": "electron/main.js",
  "license": "MIT",
  "author": {
    "name": "Kondius",
    "url": "https://github.com/Kondius/qq-agent"
  },
  "//authorNote": "原作者是 Kondius（MIT）。这里保留其署名与 URL，符合 MIT 的版权声明保留要求。没有臆造其邮箱。",
  "maintainer": {
    "name": "prolet1966",
    "email": "hs75311a@126.com"
  },
  "//maintainerNote": "maintainer/build.linux.maintainer 保留历史 Linux 打包贡献者署名；Docker 分支由 downstreamMaintainer 维护，不代表继续以 Linux 仓库为主上游。",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js",
    "test": "node test/platform-test.mjs",
    "test:platform": "node test/platform-test.mjs",
    "patch:epipe": "node scripts/patch-snowluma-epipe.mjs",
    "dist:linux": "npm run patch:epipe && electron-builder --linux deb rpm AppImage --x64",
    "dist:deb": "npm run patch:epipe && electron-builder --linux deb --x64",
    "dist:rpm": "npm run patch:epipe && electron-builder --linux rpm --x64",
    "dist:appimage": "npm run patch:epipe && electron-builder --linux AppImage --x64",
    "dist:win": "npm run patch:epipe && electron-builder --win nsis --x64",
    "docker:init": "node scripts/docker-init.mjs",
    "test:docker": "node --test test/docker-*.test.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "test:local": "node --test test/docker-*.test.mjs test/steam-deals.test.mjs test/comfy-draw.test.mjs",
    "audit:local": "node scripts/check-local-overrides.mjs",
    "audit:public": "node scripts/check-local-overrides.mjs --public-snapshot",
    "upstream:inventory": "node scripts/upstream-inventory.mjs",
    "test:upstream": "node test/prompt-anchor-test.mjs && node test/message-id-test.mjs && node test/wake-semantics-test.mjs",
    "test:extensions": "node --test test/docker-extensions-*.test.mjs && node test/safe-fetch-file-test.mjs && node test/coverage-offline.mjs"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "js-yaml": "^5.4.1",
    "mongodb": "^6.21.0",
    "qrcode": "1.5.4",
    "undici": "^6.28.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "^26.15.3"
  },
  "//electronVersionNote": "electron 必须写精确版本，不能用 ^ 范围。原因：electron-builder 需要在打包时下载『该平台对应的 Electron 二进制』，范围无法解析出唯一版本。原版写 ^33.2.0，实测报错：'Electron version \"^33.2.0\" is a range, not a fixed version.' 修复方式二选一：这里写死精确版本，或在 build 里显式设 electronVersion。",
  "build": {
    "appId": "cn.kondius.qq-agent",
    "productName": "QQ Agent",
    "asar": true,
    "asarUnpack": [
      "snowluma/**"
    ],
    "files": [
      "**/*",
      "!data/**",
      "!data-*/**",
      "!snowluma/data/**",
      "!snowluma/logs/**",
      "!snowluma/config.auto-*/**",
      "!**/*.log",
      "!**/*.map",
      "!test/**",
      "!doc/**",
      "!scripts/**",
      "!build-scripts/**",
      "!dist/**",
      "!**/*.bak-*",
      "!task_plan.md",
      "!findings.md",
      "!progress*.md",
      "!package-lock.json.bak"
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "artifactName": "qq-agent-v${version}-${arch}.${ext}",
      "synopsis": "QQ 群 AI 机器人（基于 OneBot v11 与 SnowLuma）",
      "description": "事件驱动的 QQ 群 AI 机器人。内置 SnowLuma 协议端与 Electron 运行时，接 OpenAI 兼容 API。数据目录遵循 XDG 规范存放在用户主目录。",
      "maintainer": "prolet1966 <hs75311a@126.com>",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "QQ Agent",
          "Comment": "QQ 群 AI 机器人控制台",
          "Categories": "Network;InstantMessaging;Utility;",
          "StartupWMClass": "QQ Agent"
        }
      }
    },
    "deb": {
      "depends": [
        "libnss3",
        "libgtk-3-0",
        "libasound2",
        "libgbm1",
        "libxkbcommon0",
        "libdrm2",
        "libxss1",
        "xdg-utils"
      ],
      "recommends": [
        "fonts-noto-cjk",
        "xvfb"
      ],
      "priority": "optional"
    },
    "rpm": {
      "depends": [
        "nss",
        "gtk3",
        "alsa-lib",
        "mesa-libgbm",
        "libxkbcommon",
        "libdrm",
        "libXScrnSaver",
        "xdg-utils"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "qq-agent-v${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "QQ Agent"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pcg562240/qq-agent-docker.git"
  },
  "bugs": {
    "url": "https://github.com/pcg562240/qq-agent-docker/issues"
  },
  "homepage": "https://github.com/pcg562240/qq-agent-docker#readme",
  "keywords": [
    "qq",
    "bot",
    "agent",
    "openai",
    "onebot",
    "snowluma",
    "llm",
    "desktop",
    "electron",
    "linux"
  ],
  "upstream": {
    "repository": "https://github.com/K0nd1us/QQ-agent.git",
    "commit": "11577baad321d1774caf0765d791c211072bfa83",
    "version": "0.4.0"
  },
  "downstreamMaintainer": "pcg562240/qq-agent-docker",
  "dockerVersion": "0.4.0-docker.1"
}
